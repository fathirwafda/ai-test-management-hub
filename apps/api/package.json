{
  "name": "@hub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify + SQLite API for the AI Test Management Hub.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "seed": "tsx src/seed/run.ts --reset",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@hub/shared": "0.1.0",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
